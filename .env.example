# Copy to .env.local for local-only overrides. Never commit real tokens.
ASTRAMIND_ENVIRONMENT=development
ASTRAMIND_API_HOST=127.0.0.1
ASTRAMIND_API_PORT=8010
ASTRAMIND_WEB_PORT=5174
ASTRAMIND_DATA_DIR=var/data
ASTRAMIND_CONTROL_DB_PATH=var/control/astramind.db
ASTRAMIND_TUSHARE_API_URL=https://api.tushare.pro
ASTRAMIND_TUSHARE_TOKEN=
ASTRAMIND_TUSHARE_RATE_LIMIT_PER_MINUTE=120
ASTRAMIND_TUSHARE_TIMEOUT_SECONDS=30
ASTRAMIND_TUSHARE_MAX_RETRIES=2
# Optional Windows interpreter that can import xtquant.
ASTRAMIND_MINIQMT_PYTHON=
# Optional WSL path to a Windows site-packages directory containing xtquant.
ASTRAMIND_MINIQMT_XTQUANT_PATH=
ASTRAMIND_MINIQMT_QUOTE_PORT=
ASTRAMIND_MINIQMT_PROBE_TIMEOUT_SECONDS=30
